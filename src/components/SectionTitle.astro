---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  invert?: boolean;
}

const { eyebrow, title, description, invert = false } = Astro.props;
---
<header class:list={["section-heading", invert && "section-heading--invert"]}>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</header>
