---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from './SectionTitle.astro';
import ArrowIcon from './ArrowIcon.astro';
import { content as contentData } from '../data/content';
import { site } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = contentData[locale];
const brand = locale === 'en' ? site.nameEn : site.name;
---

<BaseLayout locale={locale} path={locale === 'ja' ? '/' : `/${locale}/`} content={c}>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href="#top" aria-label={`${site.name} トップへ`}>
          <span class="brand__mon" aria-hidden="true">福</span>
          <span>{brand}</span>
        </a>
        <nav class="site-nav" aria-label="ページ内ナビゲーション">
          <a href="#highlights">{c.nav.highlights}</a>
          <a href="#food">{c.nav.food}</a>
          <a href="#access">{c.nav.access}</a>
          <a href="#nearby">{c.nav.nearby}</a>
          <a href="#faq">{c.nav.faq}</a>
          <a class="site-nav__card" href="#memory-card">{c.nav.card}</a>
        </nav>
        <div class="lang-switch" aria-label="言語切り替え / Language">
          <a href="/" hreflang="ja" class:list={['lang-switch__item', locale === 'ja' && 'is-current']}>日本語</a>
          <a href="/zh/" hreflang="zh-Hant" class:list={['lang-switch__item', locale === 'zh' && 'is-current']}>繁體中文</a>
          <a href="/en/" hreflang="en" class:list={['lang-switch__item', locale === 'en' && 'is-current']}>English</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero__image"
          src="/images/fukuyama-castle-sunset.jpg"
          alt={c.about.imgAlt}
          width="3840"
          height="2160"
          fetchpriority="high"
        />
        <div class="shell hero__content">
          <div>
            <p class="hero__kicker">{c.hero.kicker}</p>
            <h1 id="hero-title">
              {c.hero.title1}<br />{c.hero.title2}
              <span>{c.hero.titleSmall}</span>
            </h1>
            <p class="hero__lead">{c.hero.lead}</p>
            <div class="hero__actions">
              <a class="button button--light" href="#access">
                {c.hero.ctaAccess}
                <ArrowIcon />
              </a>
              <a class="button button--ghost" href="#memory-card">{c.hero.ctaCard}</a>
            </div>
          </div>
          <div class="hero__vertical" aria-hidden="true">
            <strong>{c.hero.verticalStrong}</strong>
            <small>{c.hero.verticalSmall}</small>
          </div>
        </div>
      </section>

      <aside class="quick-facts" aria-label="訪問の基本情報">
        <div class="shell quick-facts__grid">
          <article class="fact">
            <p class="fact__label">{c.quickFacts.accessLabel}</p>
            <p class="fact__value" set:html={c.quickFacts.accessValue}></p>
            <p class="fact__note">{c.quickFacts.accessNote}</p>
          </article>
          <article class="fact">
            <p class="fact__label">{c.quickFacts.parkLabel}</p>
            <p class="fact__value">{c.quickFacts.parkValue}</p>
            <p class="fact__note">{c.quickFacts.parkNote}</p>
          </article>
          <article class="fact">
            <p class="fact__label">{c.quickFacts.museumLabel}</p>
            <p class="fact__value">{c.quickFacts.museumValue}</p>
            <p class="fact__note">{c.quickFacts.museumNote}</p>
          </article>
          <article class="fact">
            <p class="fact__label">{c.quickFacts.seasonLabel}</p>
            <p class="fact__value">{c.quickFacts.seasonValue}</p>
            <p class="fact__note">{c.quickFacts.seasonNote}</p>
          </article>
        </div>
      </aside>

      <section class="section" id="about">
        <div class="shell">
          <SectionTitle eyebrow={c.about.eyebrow} title={c.about.title} description={c.about.description} />
          <div class="intro-grid reveal">
            <div class="intro-copy">
              <p class="intro-copy__lead" set:html={c.about.lead}></p>
              <p>{c.about.p1}</p>
              <p>{c.about.p2}</p>
            </div>
            <figure class="intro-image">
              <img src="/images/fukuyama-castle-spring.jpg" alt={c.about.imgAlt} width="1280" height="719" loading="lazy" />
              <figcaption>
                <span>{c.about.cap1}</span>
                <span>{c.about.cap2}</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="section section--ink" id="highlights">
        <div class="shell">
          <SectionTitle eyebrow={c.highlights.eyebrow} title={c.highlights.title} description={c.highlights.description} invert />
          <div class="highlights reveal">
            {c.highlights.items.map((item) => (
              <article class="highlight">
                <span class="highlight__number">{item.num}</span>
                <h3>{item.h3}</h3>
                <p>{item.p}</p>
                <span class="highlight__mark" aria-hidden="true">{item.mark}</span>
              </article>
            ))}
          </div>
          <div class="timeline reveal" aria-label="福山城の歴史">
            {c.highlights.timeline.map((item) => (
              <article class="timeline__item">
                <span class="timeline__year">{item.year}</span>
                <h3>{item.h3}</h3>
                <p>{item.p}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="scenery">
        <div class="shell">
          <SectionTitle eyebrow={c.scenery.eyebrow} title={c.scenery.title} description={c.scenery.description} />
          <div class="gallery-grid reveal">
            <figure class="gallery-card">
              <img src="/images/fukuyama-castle-park.jpg" alt={c.scenery.caps[0]} width="1280" height="720" loading="lazy" />
              <figcaption>{c.scenery.caps[0]}</figcaption>
            </figure>
            <figure class="gallery-card">
              <img src="/images/fukuyama-castle-spring.jpg" alt={c.scenery.caps[1]} width="1280" height="719" loading="lazy" />
              <figcaption>{c.scenery.caps[1]}</figcaption>
            </figure>
            <figure class="gallery-card">
              <img src="/images/fukuyama-castle-night-wall.jpg" alt={c.scenery.caps[2]} width="3840" height="2160" loading="lazy" />
              <figcaption>{c.scenery.caps[2]}</figcaption>
            </figure>
          </div>
          <div class="visit-note reveal">
            <strong>{c.scenery.noteStrong}</strong>
            <p>{c.scenery.noteP}</p>
          </div>
        </div>
      </section>

      <section class="section section--paper-pale" id="food">
        <div class="shell">
          <SectionTitle eyebrow={c.food.eyebrow} title={c.food.title} description={c.food.description} />
          <div class="food-grid reveal">
            {c.food.items.map((food) => (
              <article class="food-card">
                <span class="food-card__type">{food.type}</span>
                <h3>{food.title}</h3>
                <p>{food.text}</p>
                <p class="food-card__where">{food.where}</p>
              </article>
            ))}
          </div>
          <div class="food-footer reveal">
            <p>{c.food.footerP}</p>
            <a class="button button--dark" href="https://www.google.com/maps/search/?api=1&query=%E7%A6%8F%E5%B1%B1%E9%A7%85+%E9%83%BB%E5%9C%9F%E6%96%99%E7%90%86" target="_blank" rel="noreferrer">
              {c.food.footerBtn}
              <ArrowIcon />
            </a>
          </div>
        </div>
      </section>

      <section class="section section--ink" id="access">
        <div class="shell">
          <SectionTitle eyebrow={c.access.eyebrow} title={c.access.title} description={c.access.description} invert />
          <div class="access-layout">
            <div class="route-list reveal">
              {c.access.routes.map((route) => (
                <article class="route">
                  <div class="route__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24">
                      <path d="M7 17h10M8 20l2-3m6 3-2-3M7 4h10a2 2 0 0 1 2 2v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3V6a2 2 0 0 1 2-2Zm0 3h10M8 13h.01M16 13h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/>
                    </svg>
                  </div>
                  <div>
                    <h3>{route.h3}</h3>
                    <p set:html={route.p}></p>
                  </div>
                </article>
              ))}
            </div>
            <div class="access-map reveal">
              <div class="map-board" role="img" aria-label={c.access.mapLabel}>
                <span class="map-board__north">N ↑</span>
                <div class="map-castle">
                  <svg aria-hidden="true" viewBox="0 0 120 90">
                    <path d="M12 79h96M22 78V58h76v20M30 58V39h60v19M39 39V23h42v16M31 23h58L78 9H42L31 23Z" fill="none" stroke="#171714" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                    <path d="M50 64h20v15H50z" fill="#a64635"/>
                  </svg>
                  <strong>{site.name}</strong>
                </div>
                <div class="map-walk">{c.access.walkLabel}<strong>{c.quickFacts.accessValue.replace(/<br\s*\/?>/i, ' ').replace(/<[^>]+>/g, '')}</strong></div>
                <div class="map-line"></div>
                <div class="map-station">{c.access.stationLabel}</div>
                <p class="map-caption">{c.access.mapCaption}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="nearby">
        <div class="shell">
          <SectionTitle eyebrow={c.nearby.eyebrow} title={c.nearby.title} description={c.nearby.description} />
          <div class="nearby-grid reveal">
            {c.nearby.items.map((spot) => (
              <article class="nearby-card">
                <div class="nearby-card__image">
                  <img src={spot.image} alt={spot.alt} width={spot.width} height={spot.height} loading="lazy" />
                </div>
                <div class="nearby-card__body">
                  <span class="nearby-card__time">{spot.time}</span>
                  <h3>{spot.title}</h3>
                  <p>{spot.text}</p>
                  <p class="nearby-card__tag">{spot.tag}</p>
                </div>
              </article>
            ))}
          </div>
          <div class="day-plan reveal">
            <h3>{c.nearby.dayPlanTitle}</h3>
            <div class="day-plan__steps" aria-label="おすすめモデルコース">
              {c.nearby.dayPlanSteps.map((step, i) => (
                <Fragment>
                  <span>{step}</span>
                  {i < c.nearby.dayPlanSteps.length - 1 && <i>→</i>}
                </Fragment>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section section--ink" id="memory-card">
        <div class="shell">
          <SectionTitle eyebrow={c.memoryCard.eyebrow} title={c.memoryCard.title} description={c.memoryCard.description} invert />
          <div class="card-maker">
            <div class="card-controls reveal">
              <div class="privacy-badge">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
                  <path d="M7 10V7a5 5 0 0 1 10 0v3m-11 0h12v10H6V10Zm6 4v2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
                </svg>
                <div>
                  <strong>{c.memoryCard.privacyTitle}</strong>
                  <p>{c.memoryCard.privacyText}</p>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">{c.memoryCard.step1}</span>
                <div class="photo-actions">
                  <label class="photo-action" for="cameraPhoto">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                      <path d="M4 8h3l1.5-2h7L17 8h3v11H4V8Zm8 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                    </svg>
                    {c.memoryCard.step1a}
                  </label>
                  <input class="sr-only" id="cameraPhoto" data-photo-input type="file" accept="image/*" capture="environment" />
                  <label class="photo-action" for="selfiePhoto">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                      <circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M6 20c.6-4 2.5-6 6-6s5.4 2 6 6M4 4h4M4 4v4M20 4h-4m4 0v4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"/>
                    </svg>
                    {c.memoryCard.step1b}
                  </label>
                  <input class="sr-only" id="selfiePhoto" data-photo-input type="file" accept="image/*" capture="user" />
                  <label class="photo-action" for="albumPhoto">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                      <rect x="3" y="5" width="18" height="14" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="9" cy="10" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
                      <path d="m5 17 4-4 3 3 2-2 5 3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
                    </svg>
                    {c.memoryCard.step1c}
                  </label>
                  <input class="sr-only" id="albumPhoto" data-photo-input type="file" accept="image/*" />
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">{c.memoryCard.step2}</span>
                <div class="field-grid">
                  <div class="field field--full">
                    <label for="cardTitle">{c.memoryCard.titleLabel}</label>
                    <input id="cardTitle" maxlength="24" value={c.memoryCard.cardTitle} autocomplete="off" />
                  </div>
                  <div class="field">
                    <label for="cardDate">{c.memoryCard.dateLabel}</label>
                    <input id="cardDate" type="date" />
                  </div>
                  <div class="field">
                    <label for="cardSize">{c.memoryCard.sizeLabel}</label>
                    <select id="cardSize">
                      {c.memoryCard.sizeOptions.map((opt) => (
                        <option value={opt.value} selected={opt.value === 'postcard'}>{opt.label}</option>
                      ))}
                    </select>
                  </div>
                  <div class="field field--full">
                    <label for="cardNote">{c.memoryCard.noteLabel}</label>
                    <textarea id="cardNote" maxlength="56">{c.memoryCard.cardNote}</textarea>
                  </div>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">{c.memoryCard.styleLabel}</span>
                <div class="style-options">
                  <label class="style-option">
                    <input class="sr-only" type="radio" name="cardStyle" value="iron" checked />
                    {c.memoryCard.styleIron}
                  </label>
                  <label class="style-option">
                    <input class="sr-only" type="radio" name="cardStyle" value="sakura" />
                    {c.memoryCard.styleSakura}
                  </label>
                  <label class="style-option">
                    <input class="sr-only" type="radio" name="cardStyle" value="gold" />
                    {c.memoryCard.styleGold}
                  </label>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">{c.memoryCard.step4}</span>
                <div class="range-grid">
                  <div class="range-field">
                    <label for="photoZoom">{c.memoryCard.zoomLabel}</label>
                    <input id="photoZoom" type="range" min="1" max="2.4" value="1" step="0.02" />
                  </div>
                  <div class="range-field">
                    <label for="photoFocusX">{c.memoryCard.fxLabel}</label>
                    <input id="photoFocusX" type="range" min="0" max="100" value="50" step="1" />
                  </div>
                  <div class="range-field">
                    <label for="photoFocusY">{c.memoryCard.fyLabel}</label>
                    <input id="photoFocusY" type="range" min="0" max="100" value="50" step="1" />
                  </div>
                </div>
              </div>
              <div class="download-row">
                <button class="button button--gold" id="downloadCard" type="button">
                  {c.memoryCard.download}
                  <ArrowIcon />
                </button>
                <small>{c.memoryCard.downloadNote}</small>
              </div>
              <button class="button button--ghost" id="resetCard" type="button">{c.memoryCard.reset}</button>
              <p class="card-status" id="cardStatus" aria-live="polite"></p>
            </div>
            <div class="card-preview-wrap reveal">
              <div class="card-preview-shell">
                <canvas id="memorialCanvas" width="1000" height="1480" aria-label="福山城公園の記念カードプレビュー"></canvas>
              </div>
              <div class="card-preview-meta">
                <span>{c.memoryCard.previewLabel}</span>
                <span id="previewSizeLabel">{c.memoryCard.previewSize}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--compact section--paper-pale" id="visit-info">
        <div class="shell">
          <SectionTitle eyebrow={c.visitInfo.eyebrow} title={c.visitInfo.title} description={c.visitInfo.description} />
          <div class="visit-info-grid reveal">
            {c.visitInfo.cards.map((card) => (
              <article class="visit-info-card">
                <span class="visit-info-card__label">{card.label}</span>
                <h3>{card.h3}</h3>
                <dl>
                  {card.dl.map((row) => (
                    <Fragment>
                      <dt>{row.dt}</dt><dd>{row.dd}</dd>
                    </Fragment>
                  ))}
                </dl>
              </article>
            ))}
          </div>
          <p class="notice reveal">{c.visitInfo.notice}</p>
        </div>
      </section>

      <section class="section section--paper-pale" id="faq">
        <div class="shell">
          <SectionTitle eyebrow="FAQ" title={c.nav.faq} />
          <div class="faq-list reveal">
            {c.faq.map((item) => (
              <article class="faq-item">
                <h3 class="faq-item__q">{item.q}</h3>
                <p class="faq-item__a">{item.a}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-cta">
          <div>
            <h2>{c.footer.ctaTitle}</h2>
            <p>{c.footer.ctaP}</p>
          </div>
          <div class="hero__actions">
            <a class="button button--light" href={site.mapsUrl} target="_blank" rel="noreferrer">
              {c.nav.access}
              <ArrowIcon />
            </a>
            <a class="button button--ghost" href={site.officialUrl} target="_blank" rel="noreferrer">{c.footer.links.about}</a>
          </div>
        </div>
        <div class="footer-main">
          <div class="footer-brand">{brand}</div>
          <nav class="footer-links" aria-label="フッターナビゲーション">
            <a href="#about">{c.footer.links.about}</a>
            <a href="#food">{c.footer.links.food}</a>
            <a href="#access">{c.footer.links.access}</a>
            <a href="#nearby">{c.footer.links.nearby}</a>
            <a href="#faq">{c.footer.links.faq}</a>
            <a href="#memory-card">{c.footer.links.card}</a>
          </nav>
          <details class="photo-credits">
            <summary>{c.footer.photoSummary}</summary>
            <p>{c.footer.photoText}</p>
          </details>
        </div>
      </div>
      <p class="disclaimer shell">{c.footer.disclaimer}</p>
    </footer>

    <script>
      import '../scripts/memorial-card.ts';
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }, { threshold: 0.12 });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</BaseLayout>
